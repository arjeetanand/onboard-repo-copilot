# Local-only configuration. Copy this file to .env; never commit real credentials.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./data/onboard_repo_copilot.db
PROJECT_DATA_DIR=./data
ALLOWED_REPO_HOSTS=github.com,www.github.com
MAX_REPO_FILES=250
MAX_REPO_FILE_BYTES=250000
GITHUB_TOKEN=

# Optional integrations are deliberately disabled by default.
ENABLE_OCI_GENAI=false
OCI_REGION=
OCI_COMPARTMENT_ID=
OCI_PROFILE=DEFAULT
OCI_CONFIG_FILE=
OCI_MODEL_ID=
OCI_ENDPOINT=
SLACK_NOTIFY_ESCALATIONS=false
SLACK_WEBHOOK_URL=

# This is public browser configuration, not a secret.
VITE_API_URL=http://localhost:8000
